# ==============================================================================
# Duckuu - Environment Variables Template
# Copy this file to '.env' and fill in your API keys before running the application.
# DO NOT commit your actual '.env' file with real credentials to GitHub!
# ==============================================================================

# Google Gemini API (Required for Agentic Reasoning, Multimodal Vision, and Artifact Engine)
# Get your key at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Deepgram API (Required for Real-time Streaming Voice-to-Text / STT)
# Get your key at: https://console.deepgram.com/
DEEPGRAM_API_KEY=your_deepgram_api_key_here

# ElevenLabs API (Required for Ultra-low Latency Text-to-Speech / TTS & Duck Voice)
# Get your key at: https://elevenlabs.io/
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# Groq API (Optional: Fast LLM Inference Fallback)
# Get your key at: https://console.groq.com/
GROQ_API_KEY=your_groq_api_key_here

# Default Cloud Provider ("gemini" or "groq")
DEFAULT_CLOUD_PROVIDER=gemini

# Server Configuration
HOST=127.0.0.1
PORT=8000
